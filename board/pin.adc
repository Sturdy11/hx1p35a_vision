#=============================================================================
# 引脚约束  HX1P35A (PH1P35MDG324)  —— 选题二 实时数字图像处理系统
#   KEY1..4: 按键；逻辑 SW1..4: 低有效扩展输入；LED1..4: 指示灯
#   N2: 目标存在输出；J14: 清点报警输出
#=============================================================================

# ---- 系统时钟与复位 ----
set_pin_assignment	{ I_sys_clk }			{ LOCATION = C4; IOSTANDARD  = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_rst_n }				{ LOCATION = R10; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# ---- 摄像头 I2C ----
set_pin_assignment	{ O_cam_scl }		{ LOCATION = K3; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ IO_cam_sda }		{ LOCATION = J3; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ O_cam_24m }	{ LOCATION = L3; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ O_cam_rst }		{ LOCATION = L2; IOSTANDARD  = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }

# ---- 机电联动扩展口 (GPIO 输出) ----
#   N2: 检测到已确认目标时输出高电平
#   J14: 清点报警输出
set_pin_assignment	{ I_button[0] }			{ LOCATION = N2;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_button[1] }			{ LOCATION = J14; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLUP; }

# ---- 板载按键 (低有效) ----
set_pin_assignment	{ I_key_n[0] }			{ LOCATION = D5; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_key_n[1] }			{ LOCATION = A9; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_key_n[2] }			{ LOCATION = B9; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_key_n[3] }			{ LOCATION = C7; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# ---- 逻辑 SW1..SW4 对应的扩展输入（低有效，以管脚核对板上丝印） ----
#  依据官方例程 2_Example/8_key_sw/key_sw.adc: key[4..7] = A4/B4/E11/D11 (PULLUP)
#  alg_ctrl.v 内部已取反, 空闲 = 档位 0
set_pin_assignment	{ I_sw[0] }				{ LOCATION = A4;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_sw[1] }				{ LOCATION = B4;  IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_sw[2] }				{ LOCATION = E11; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }
set_pin_assignment	{ I_sw[3] }				{ LOCATION = D11; IOSTANDARD = LVCMOS33; PULLTYPE = PULLUP; }

# ---- 板载 LED (高电平点亮) ----
set_pin_assignment	{ O_led[0] }			{ LOCATION = D10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; }
set_pin_assignment	{ O_led[1] }			{ LOCATION = E10; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; }
set_pin_assignment	{ O_led[2] }			{ LOCATION = C6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; }
set_pin_assignment	{ O_led[3] }			{ LOCATION = D6;  IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; }

# ---- HDMI 输出 ----
set_pin_assignment	{ O_screen_pwm } 		{ LOCATION = R11; IOSTANDARD = LVCMOS33; DRIVESTRENGTH = 8; PULLTYPE = PULLDOWN; }
set_pin_assignment	{ O_tmds_ch0_p }		{ LOCATION = G16; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment	{ O_tmds_ch1_p }		{ LOCATION = F17; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment	{ O_tmds_ch2_p }		{ LOCATION = H14; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
set_pin_assignment	{ O_tmds_clk_p }		{ LOCATION = C17; IOSTANDARD = TMDS33; PULLTYPE = NONE; }
